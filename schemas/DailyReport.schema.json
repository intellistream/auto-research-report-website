{
  "$defs": {
    "DailyChapter": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "startup",
            "scheduling",
            "prefill",
            "pd_transfer",
            "decode",
            "speculative",
            "output_return",
            "resource_reclaim",
            "papers"
          ],
          "title": "Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/DailyGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "intro": {
          "title": "Intro",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "groups",
        "intro"
      ],
      "title": "DailyChapter",
      "type": "object"
    },
    "DailyEntry": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Number",
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/DisplayCard"
        }
      },
      "required": [
        "number",
        "card"
      ],
      "title": "DailyEntry",
      "type": "object"
    },
    "DailyGroup": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DailyEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "title",
        "entries"
      ],
      "title": "DailyGroup",
      "type": "object"
    },
    "DisplayCard": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Card Id",
          "type": "string"
        },
        "work_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Work Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "ascend",
            "upstream",
            "paper"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/ReportContent"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "card_id",
        "work_id",
        "source_type",
        "content"
      ],
      "title": "DisplayCard",
      "type": "object"
    },
    "PRCandidate": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "enum": [
            "vllm-project/vllm",
            "vllm-project/vllm-ascend"
          ],
          "title": "Repository",
          "type": "string"
        },
        "pr_number": {
          "exclusiveMinimum": 0,
          "title": "Pr Number",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "screening": {
          "anyOf": [
            {
              "enum": [
                "relevant",
                "irrelevant",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screening"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "source_issue": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Issue"
        }
      },
      "required": [
        "repository",
        "pr_number",
        "title"
      ],
      "title": "PRCandidate",
      "type": "object"
    },
    "PROutcome": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/PRCandidate"
        },
        "status": {
          "enum": [
            "included",
            "excluded",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "status",
        "reason"
      ],
      "title": "PROutcome",
      "type": "object"
    },
    "ReportContent": {
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "enum": [
            "startup",
            "scheduling",
            "prefill",
            "pd_transfer",
            "decode",
            "speculative",
            "output_return",
            "resource_reclaim",
            "papers"
          ],
          "title": "Chapter",
          "type": "string"
        },
        "title_zh": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title Zh",
          "type": "string"
        },
        "original_title": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Title"
        },
        "title_status": {
          "anyOf": [
            {
              "enum": [
                "reused",
                "generated",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title Status"
        },
        "title_error": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title Error"
        },
        "body": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "body_source": {
          "anyOf": [
            {
              "enum": [
                "assembled_report_content",
                "analysis_projection"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Source"
        },
        "problem": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        },
        "optimization": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimization"
        },
        "effects_and_limits": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effects And Limits"
        },
        "source_links": {
          "items": {
            "$ref": "#/$defs/SourceLink"
          },
          "minItems": 1,
          "title": "Source Links",
          "type": "array"
        },
        "diagram_nodes": {
          "items": {
            "enum": [
              "startup",
              "scheduling",
              "prefill",
              "pd_transfer",
              "decode",
              "speculative",
              "output_return",
              "resource_reclaim"
            ],
            "type": "string"
          },
          "title": "Diagram Nodes",
          "type": "array"
        },
        "location_basis": {
          "default": "delivered_chapter",
          "description": "Display placement only; title/default fallback is provisional, never a review receipt.",
          "enum": [
            "delivered_chapter",
            "title_hint",
            "default_scheduling"
          ],
          "title": "Location Basis",
          "type": "string"
        }
      },
      "required": [
        "chapter",
        "title_zh",
        "source_links",
        "diagram_nodes"
      ],
      "title": "ReportContent",
      "type": "object"
    },
    "SourceLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "SourceLink",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "daily-report/0.4",
      "default": "daily-report/0.4",
      "title": "Schema Version",
      "type": "string"
    },
    "day": {
      "format": "date",
      "title": "Day",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "coverage_notice": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Coverage Notice"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/DailyChapter"
      },
      "title": "Chapters",
      "type": "array"
    },
    "numbers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Numbers",
      "type": "object"
    },
    "diagram_numbers": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Diagram Numbers",
      "type": "object"
    },
    "pending_prs": {
      "items": {
        "$ref": "#/$defs/PROutcome"
      },
      "title": "Pending Prs",
      "type": "array"
    }
  },
  "required": [
    "day",
    "synthetic",
    "coverage_notice",
    "summary",
    "chapters",
    "numbers",
    "diagram_numbers"
  ],
  "title": "DailyReport",
  "type": "object"
}
