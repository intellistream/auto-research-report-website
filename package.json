{
  "name": "auto-research-report-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only website for community daily research reports",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:docx": "vite --mode docx --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "predev": "node scripts/prepare-catalog.mjs",
    "pretest": "node scripts/prepare-catalog.mjs",
    "prebuild": "node scripts/prepare-catalog.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.5.3"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.2"
  }
}
