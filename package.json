{
  "name": "auto-research-report-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only website for community daily research reports",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:docx": "vite --mode docx --host 127.0.0.1",
    "dev:pipeline": "vite --mode pipeline --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "npm run test:group-mods && vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "check:topic-survey": "node scripts/check-topic-surveys.mjs",
    "predev": "npm run check:topic-survey && node scripts/prepare-catalog.mjs && npm run check:group-mods",
    "pretest": "npm run check:topic-survey && node scripts/prepare-catalog.mjs && npm run check:group-mods",
    "prebuild": "npm run check:topic-survey && node scripts/prepare-catalog.mjs && npm run check:group-mods",
    "import:group-mods": "node scripts/import-group-research.mjs",
    "check:group-mods": "node scripts/check-group-research.mjs",
    "test:group-mods": "node --test scripts/tests/group-research-*.node.mjs scripts/tests/community-corpus.node.mjs scripts/tests/mod-pr-screening.node.mjs",
    "build:community-corpus": "node scripts/build-community-corpus.mjs",
    "screen:mod-prs": "node scripts/screen-mod-prs.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
