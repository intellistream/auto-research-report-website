  "synthesis": [
    {
      "title": "先测实际宽度，再评估 AV",
      "body": "假设：候选裁剪收益受估计器输入和后端执行形状制约。",
      "design": "固定模型与 draft，比较 AV off/on；在可变 K 和负载下记录估计、预算、实际 Q、graph mode。",
      "measure": "AL、物理 verify 时间、吞吐、TPOT、host cost。",
      "decision": "若 AL 下降但 verify 未变，排查无效裁剪；若低并发负收益，保留负对照。",
      "sourceIds": [
        "github:vllm-project/vllm#65175",
        "github:vllm-project/vllm#65874",
        "github:vllm-project/vllm#65488"
      ]
    },
    {
      "title": "P/D 节点只保留必要状态",
      "body": "假设：纯 P 不需要 proposal query，但 Decode 仍需要 context KV。",
      "design": "比较同条件 P/D 两臂；核对 KV 交接、DP 同步和状态完整后再启用 skip。",
      "measure": "TTFT、P 侧设备时间、KV 容量、输出正确性。",
      "decision": "若有 rank 需要候选或交接状态不全，回退。",
